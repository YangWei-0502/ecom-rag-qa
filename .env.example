# ===== 对话模型模式：ollama（本地，默认） / deepseek（云端备选） =====
MODEL_PROVIDER=ollama
# 切到 deepseek 时填写：
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# ===== 本地 Ollama（嵌入统一走本地，免费且隐私不出本机） =====
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_EMBED_MODEL=qwen3-embedding:4b

# ===== 对话与检索 =====
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=60
LLM_MAX_HISTORY_MESSAGES=20
RETRIEVER_TOP_K=6
SCORE_DISTANCE_THRESHOLD=1.2
SCORE_RELATIVE_SPREAD=0.35
# 实测后默认开混合（Recall@6=1.0 / MRR 0.972→1.0 / 离题拒答率=1.0，见 evals/results/）
ENABLE_HYBRID_SEARCH=true
# BM25 二元分词 + 绝对分地板（实测相关 2.6~4.3，离题 ≤1.45）
BM25_MIN_SCORE=2.0
BM25_MIN_MATCHED_TOKENS=2

# ===== 重排序（评测实测：混合+重排与混合持平，默认关；代码保留可开） =====
ENABLE_RERANK=false
RERANK_CANDIDATES=10
ENABLE_LLM_RERANK=false
LLM_RERANK_TIMEOUT_SECONDS=30

# ===== API（FastAPI 8002） =====
RATE_LIMIT_PER_MINUTE=120
API_PORT=8002

# ===== 分块 / 上传 / 多用户 =====
CHUNK_SIZE=500
CHUNK_OVERLAP=120
MAX_UPLOAD_BYTES=10485760
DEFAULT_USER_ID=local_user
